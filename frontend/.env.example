VITE_API_URL=http://localhost:8000

# From your Supabase project: Settings -> API. Use the publishable key, not
# the legacy anon key or the secret key — publishable is meant to be exposed
# client-side (Row Level Security enforces access); secret never belongs
# here or anywhere in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the idea-portal deployment (see ~/Code/idea-portal). The
# Ideas button appends `?project=randoo#access_token=...` to this itself.
VITE_IDEAS_URL=http://localhost:5174
